# Copy this file to .env and fill in your own Supabase project's values.
# Both are safe to expose client-side; access is restricted via Row Level Security policies.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Opens the Admin Test Lab in `npm run dev`. Has no effect in a production
# build: the check is `import.meta.env.DEV && this flag`, and DEV is statically
# false there, so the door cannot travel with a leaked .env.
VITE_ENABLE_DEV_ADMIN=false
